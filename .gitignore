# Python 缓存
__pycache__/
*.py[cod]

# 设计 / 测试 / 临时产物（内部脚手架，非交付物）
_build/
*.tmp

# 运行日志与临时工作目录
*.log
.work/
jianjianji_work/

# 用户数据：工程库与持久素材库（不进仓库）
projects/
media_store/

# AI 助手配置（含 API Key，绝不进仓库 / 不分发）
ai_config.json

# 系统 / 编辑器
Thumbs.db
.DS_Store
.vscode/
.idea/

# 打包产物（PyInstaller / 安装程序）——不进仓库，体积大
build/
dist/
*.spec.bak

# 打包用 ffmpeg 二进制（体积大，不进仓库；打包脚本会拷进 dist）
packaging/ffmpeg/
